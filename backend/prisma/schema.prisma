datasource db {
  provider = "mysql"
}

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

enum UserRole {
  ADMIN
  DEVELOPER
}

enum ProjectStatus {
  ATIVO
  PAUSADO
  CONCLUIDO
  CANCELADO
  NA_FILA
}

enum TaskStatus {
  BACKLOG
  PLANEJADA
  BLOQUEADA
  EM_DESENVOLVIMENTO
  EM_REVISAO
  HOMOLOGACAO
  CONCLUIDA
  CANCELADA
}

enum DependencyType {
  BLOCKS
  BLOCKED_BY
  RELATED
}

enum AuditEntityType {
  TASK
  PROJECT
  MODULE
  EPIC
  USER
}

enum AuditAction {
  CREATED
  UPDATED
  DELETED
  STATUS_CHANGED
  ASSIGNED
  COMMENTED
  TIME_LOGGED
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_UPDATED
  TASK_BLOCKED
  TASK_COMPLETED
  TASK_OVERDUE
  COMMENT_ADDED
  DEPENDENCY_RESOLVED
  PROJECT_UPDATED
}

enum TimeLogSource {
  TIMER
  MANUAL
}

enum ModuleStatus {
  INICIADO
  EM_PROCESSO
  CONCLUIDO
}

/// Grupo/base lógica (ex.: Desenvolvimento, Marketing). Todo dado de domínio
/// pertence a exatamente um Tenant e o isolamento é aplicado automaticamente.
model Tenant {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(100)
  slug      String   @unique @db.VarChar(50)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companies                  Company[]
  users                      User[]
  apiTokens                  ApiToken[]
  userPermissions            UserPermission[]
  projects                   Project[]
  projectDevelopers          ProjectDeveloper[]
  modules                    Module[]
  epics                      Epic[]
  epicDevelopers             EpicDeveloper[]
  tasks                      Task[]
  subtasks                   Subtask[]
  taskDependencies           TaskDependency[]
  timeLogs                   TimeLog[]
  comments                   Comment[]
  notifications              Notification[]
  auditLogs                  AuditLog[]
  statusHistories            StatusHistory[]
  taskNotes                  TaskNote[]
  taskAttachments            TaskAttachment[]
  moduleAttachments          ModuleAttachment[]
  projectShowcaseAttachments ProjectShowcaseAttachment[]
  projectDemandAttachments   ProjectDemandAttachment[]

  @@map("tenants")
}

model Company {
  id        String    @id @default(uuid())
  tenantId  String    @default(uuid())
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name      String    @db.VarChar(100)
  shortName String    @db.VarChar(10)
  color     String    @db.VarChar(7) // Hex: #FFFFFF
  cnpj      String?   @db.VarChar(18)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  projects  Project[]

  @@unique([tenantId, cnpj])
  @@index([tenantId])
  @@map("companies")
}

model User {
  id           String    @id @default(uuid())
  tenantId     String    @default(uuid())
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name         String    @db.VarChar(100)
  email        String    @db.VarChar(150)
  passwordHash String    @db.VarChar(255)
  role         UserRole  @default(DEVELOPER)
  avatar       String?   @db.VarChar(255)
  position     String    @db.VarChar(100)
  department   String    @db.VarChar(100)
  isActive     Boolean   @default(true)
  isApproved   Boolean   @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  managedProjects            Project[]                   @relation("ProjectOwner")
  projects                   ProjectDeveloper[]
  epicAssignments            EpicDeveloper[]
  assignedTasks              Task[]                      @relation("TaskAssignee")
  reportedTasks              Task[]                      @relation("TaskReporter")
  subtasks                   Subtask[]
  timeLogs                   TimeLog[]
  comments                   Comment[]
  notifications              Notification[]
  auditLogs                  AuditLog[]
  statusHistories            StatusHistory[]
  taskNotes                  TaskNote[]
  attachments                TaskAttachment[]
  moduleAttachments          ModuleAttachment[]
  projectShowcaseAttachments ProjectShowcaseAttachment[]
  projectDemandAttachments   ProjectDemandAttachment[]
  loggedModules              Module[]                    @relation("ModuleLoggedBy")
  permissions                UserPermission[]
  apiTokens                  ApiToken[]

  @@unique([tenantId, email])
  @@index([email])
  @@index([tenantId])
  @@map("users")
}

model ApiToken {
  id          String    @id @default(uuid())
  tenantId    String    @default(uuid())
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String    @db.VarChar(100)
  tokenHash   String    @unique @db.VarChar(64)
  tokenPrefix String    @db.VarChar(20)
  scopes      Json      @default("[]")
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@index([tenantId])
  @@map("api_tokens")
}

model UserPermission {
  id        String   @id @default(uuid())
  tenantId  String   @default(uuid())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  module    String   @db.VarChar(50)
  action    String   @db.VarChar(20)
  granted   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, module, action])
  @@index([userId])
  @@index([tenantId])
  @@map("user_permissions")
}

model Project {
  id                   String        @id @default(uuid())
  tenantId             String        @default(uuid())
  tenant               Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  companyId            String?
  company              Company?      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name                 String        @db.VarChar(150)
  description          String        @db.Text
  technicalDescription String?       @db.Text
  demandDescription    String?       @db.Text
  requestedBy          String?       @db.VarChar(150)
  status               ProjectStatus @default(NA_FILA)
  ownerId              String
  owner                User          @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  startDate            DateTime      @db.Date
  endDate              DateTime?     @db.Date
  estimatedHours       Int           @default(0)
  actualHours          Float         @default(0.0)
  progress             Int           @default(0)
  color                String        @db.VarChar(7)
  avatar               String?       @db.LongText
  testUrl              String?       @db.VarChar(255)
  queueOrder           Int?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  developers          ProjectDeveloper[]
  modules             Module[]
  epics               Epic[]
  tasks               Task[]
  timeLogs            TimeLog[]
  notifications       Notification[]
  showcaseAttachments ProjectShowcaseAttachment[]
  demandAttachments   ProjectDemandAttachment[]

  @@index([companyId])
  @@index([ownerId])
  @@index([status])
  @@index([tenantId])
  @@map("projects")
}

model ProjectDeveloper {
  tenantId  String  @default(uuid())
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([tenantId])
  @@map("project_developers")
}

model Module {
  id             String             @id @default(uuid())
  tenantId       String             @default(uuid())
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  projectId      String
  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name           String             @db.VarChar(100)
  description    String             @db.Text
  status         ModuleStatus       @default(INICIADO)
  order          Int                @default(0)
  progress       Int                @default(0)
  workDate       DateTime?          @db.Date
  loggedHours    Float?
  loggedByUserId String?
  loggedBy       User?              @relation("ModuleLoggedBy", fields: [loggedByUserId], references: [id], onDelete: SetNull)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  epics          Epic[]
  tasks          Task[]
  attachments    ModuleAttachment[]

  @@index([projectId])
  @@index([loggedByUserId])
  @@index([tenantId])
  @@map("modules")
}

model Epic {
  id          String          @id @default(uuid())
  tenantId    String          @default(uuid())
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  moduleId    String
  module      Module          @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  name        String          @db.VarChar(100)
  description String          @db.Text
  status      ProjectStatus   @default(ATIVO)
  startDate   DateTime        @db.Date
  endDate     DateTime?       @db.Date
  progress    Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  tasks       Task[]
  developers  EpicDeveloper[]

  @@index([projectId])
  @@index([moduleId])
  @@index([tenantId])
  @@map("epics")
}

model EpicDeveloper {
  tenantId String @default(uuid())
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  epicId   String
  epic     Epic   @relation(fields: [epicId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([epicId, userId])
  @@index([userId])
  @@index([tenantId])
  @@map("epic_developers")
}

model Task {
  id                   String      @id @default(uuid())
  tenantId             String      @default(uuid())
  tenant               Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  projectId            String
  project              Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  moduleId             String
  module               Module      @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  epicId               String
  epic                 Epic        @relation(fields: [epicId], references: [id], onDelete: Cascade)
  parentTaskId         String?
  parentTask           Task?       @relation("TaskSubtask", fields: [parentTaskId], references: [id], onDelete: SetNull)
  title                String      @db.VarChar(200)
  description          String      @db.Text
  status               TaskStatus  @default(BACKLOG)
  complexity           Int         @default(1)
  assigneeId           String
  assignee             User        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  reporterId           String
  reporter             User        @relation("TaskReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  estimatedHours       Int         @default(0)
  actualHours          Float       @default(0.0)
  startDate            DateTime?   @db.Date
  dueDate              DateTime?   @db.Date
  completedAt          DateTime?
  blockedReason        String?     @db.Text
  isUrgent             Boolean     @default(false)
  urgentBlockedById    String?
  urgentPreviousStatus TaskStatus?
  order                Int         @default(0)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  subtasks        Subtask[]
  childTasks      Task[]           @relation("TaskSubtask")
  dependencies    TaskDependency[] @relation("TaskPrimary")
  dependencyOf    TaskDependency[] @relation("TaskDependent")
  timeLogs        TimeLog[]
  comments        Comment[]
  statusHistories StatusHistory[]
  notes           TaskNote[]
  attachments     TaskAttachment[]
  notifications   Notification[]

  @@index([projectId])
  @@index([moduleId])
  @@index([epicId])
  @@index([assigneeId])
  @@index([status])
  @@index([tenantId])
  @@map("tasks")
}

model Subtask {
  id         String   @id @default(uuid())
  tenantId   String   @default(uuid())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title      String   @db.VarChar(200)
  completed  Boolean  @default(false)
  assigneeId String?
  assignee   User?    @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([taskId])
  @@index([tenantId])
  @@map("subtasks")
}

model TaskDependency {
  id              String         @id @default(uuid())
  tenantId        String         @default(uuid())
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  taskId          String
  task            Task           @relation("TaskPrimary", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTaskId String
  dependsOnTask   Task           @relation("TaskDependent", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)
  type            DependencyType @default(BLOCKED_BY)
  createdAt       DateTime       @default(now())

  @@unique([taskId, dependsOnTaskId])
  @@index([tenantId])
  @@map("task_dependencies")
}

model TimeLog {
  id              String        @id @default(uuid())
  tenantId        String        @default(uuid())
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  projectId       String
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId          String
  task            Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  hours           Float
  durationSeconds Int?
  description     String        @db.Text
  date            DateTime      @db.Date
  startedAt       DateTime?
  endedAt         DateTime?
  source          TimeLogSource @default(MANUAL)
  status          TaskStatus
  createdAt       DateTime      @default(now())

  @@index([taskId])
  @@index([userId])
  @@index([projectId])
  @@index([date])
  @@index([projectId, date])
  @@index([userId, date])
  @@index([projectId, userId, date])
  @@index([tenantId])
  @@map("time_logs")
}

model Comment {
  id        String   @id @default(uuid())
  tenantId  String   @default(uuid())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  mentions  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
  @@index([tenantId])
  @@map("comments")
}

model Notification {
  id               String           @id @default(uuid())
  tenantId         String           @default(uuid())
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type             NotificationType
  title            String           @db.VarChar(150)
  message          String           @db.Text
  read             Boolean          @default(false)
  relatedTaskId    String?
  relatedTask      Task?            @relation(fields: [relatedTaskId], references: [id], onDelete: SetNull)
  relatedProjectId String?
  relatedProject   Project?         @relation(fields: [relatedProjectId], references: [id], onDelete: SetNull)
  createdAt        DateTime         @default(now())

  @@index([userId])
  @@index([read])
  @@index([tenantId])
  @@map("notifications")
}

model AuditLog {
  id            String          @id @default(uuid())
  tenantId      String          @default(uuid())
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  entityType    AuditEntityType
  entityId      String
  action        AuditAction
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  previousValue Json?
  newValue      Json?
  description   String          @db.Text
  createdAt     DateTime        @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([tenantId])
  @@map("audit_logs")
}

model StatusHistory {
  id         String     @id @default(uuid())
  tenantId   String     @default(uuid())
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  taskId     String
  task       Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fromStatus TaskStatus
  toStatus   TaskStatus
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  duration   Int        @default(0)
  createdAt  DateTime   @default(now())

  @@index([taskId])
  @@index([tenantId])
  @@map("status_histories")
}

model TaskNote {
  id        String   @id @default(uuid())
  tenantId  String   @default(uuid())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
  @@index([tenantId])
  @@map("task_notes")
}

model TaskAttachment {
  id        String   @id @default(uuid())
  tenantId  String   @default(uuid())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String   @db.VarChar(150)
  type      String   @db.VarChar(100)
  size      Int
  dataUrl   String   @db.LongText
  createdAt DateTime @default(now())

  @@index([taskId])
  @@index([tenantId])
  @@map("task_attachments")
}

model ModuleAttachment {
  id        String   @id @default(uuid())
  tenantId  String   @default(uuid())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  moduleId  String
  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String   @db.VarChar(150)
  type      String   @db.VarChar(100)
  size      Int
  dataUrl   String   @db.LongText
  createdAt DateTime @default(now())

  @@index([moduleId])
  @@index([tenantId])
  @@map("module_attachments")
}

model ProjectShowcaseAttachment {
  id        String   @id @default(uuid())
  tenantId  String   @default(uuid())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String   @db.VarChar(150)
  type      String   @db.VarChar(100)
  size      Int
  dataUrl   String   @db.LongText
  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([tenantId])
  @@map("project_showcase_attachments")
}

model ProjectDemandAttachment {
  id        String   @id @default(uuid())
  tenantId  String   @default(uuid())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String   @db.VarChar(150)
  type      String   @db.VarChar(100)
  size      Int
  dataUrl   String   @db.LongText
  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([tenantId])
  @@map("project_demand_attachments")
}
